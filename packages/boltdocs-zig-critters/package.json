{
  "name": "@bdocs/zig-critters",
  "version": "0.3.0",
  "description": "Critical CSS extraction engine written in Zig, compiled to WebAssembly",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "wasm/index.mjs",
  "types": "wasm/index.d.ts",
  "exports": {
    ".": {
      "import": "./wasm/index.mjs",
      "types": "./wasm/index.d.ts"
    }
  },
  "scripts": {
    "build:wasm": "cd zig && zig build -Dtarget=wasm32-freestanding -Doptimize=ReleaseSmall",
    "build:native": "cd zig && zig build -Doptimize=ReleaseSmall",
    "build": "zig version >/dev/null 2>&1 && pnpm run build:wasm || echo 'Zig not installed, skipping build'",
    "dev": "cd zig && zig build",
    "test": "cd zig && zig build test",
    "test:js": "node --test wasm/*.test.mjs",
    "bench": "pnpm run build:wasm && node bench/bench.mjs"
  },
  "files": [
    "dist/",
    "wasm/",
    "zig/src/",
    "zig/build.zig",
    "zig/zig-out/bin/zig-critters.wasm"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsdown": "catalog:"
  }
}
