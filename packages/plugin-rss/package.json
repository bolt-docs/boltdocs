{
  "name": "@bdocs/plugin-rss",
  "version": "0.1.0",
  "description": "RSS/Atom feed generator plugin for Boltdocs",
  "main": "dist/node/index.js",
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "boltdocs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "boltdocs": "workspace:*",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
