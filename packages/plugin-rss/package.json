{
  "name": "@bdocs/plugin-rss",
  "version": "2.0.3",
  "description": "RSS/Atom feed generator plugin for Boltdocs",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@bdocs/contracts": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "boltdocs": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "boltdocs": "workspace:^",
    "tsdown": "^0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
