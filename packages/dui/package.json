{
  "name": "@bdocs/dui",
  "version": "0.1.0",
  "description": "Terminal UI utilities for Boltdocs — boxes, colors, logging, lists, and dividers",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
