{
  "name": "@bdocs/theme-neutral",
  "version": "1.0.0",
  "type": "module",
  "description": "The neutral Boltdocs theme: the full UI-base component set, the MDX components, and their hooks. Depends on @bdocs/runtime and @bdocs/primitives; installable on its own.",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./composition": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./mdx": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./components/primitives": {
      "types": "./dist/components-primitives.d.mts",
      "import": "./dist/components-primitives.mjs"
    },
    "./css": "./dist/neutral.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "dependencies": {
    "@bdocs/contracts": "workspace:*",
    "@bdocs/primitives": "workspace:*",
    "@bdocs/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^24.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
