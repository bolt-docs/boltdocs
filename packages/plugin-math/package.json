{
  "name": "@bdocs/plugin-math",
  "version": "1.0.0",
  "description": "KaTeX math plugin for Boltdocs",
  "main": "dist/node/index.js",
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs"
    },
    "./style.css": "./dist/client/index.css"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun && node -e \"require('fs').cpSync('src/client/index.css', 'dist/client/index.css')\"",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "katex": "^0.16.11"
  },
  "peerDependencies": {
    "@bdocs/dui": "^0.2.0",
    "boltdocs": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "boltdocs": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
