{
  "name": "@bdocs/plugin-git-meta",
  "version": "0.1.0",
  "description": "Git-derived page metadata for Boltdocs — last-updated dates and contributor lists",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "boltdocs": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "boltdocs": "workspace:^",
    "jsdom": "^24.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsdown-config": "workspace:*"
  }
}
