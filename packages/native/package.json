{
  "name": "@bdocs/native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "zig-out/bin/bdocs-parser.wasm"
  ],
  "scripts": {
    "build": "tsdown index.ts && zig build -Doptimize=ReleaseFast",
    "build:wasm": "zig build -Dtarget=wasm32-wasi -Doptimize=ReleaseFast",
    "test": "zig build test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
