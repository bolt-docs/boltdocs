{
  "name": "@bdocs/processor-satteri",
  "version": "1.0.0",
  "description": "Sätteri MDX processor for Boltdocs (Rust-based)",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "dependencies": {
    "@bdocs/contracts": "workspace:*",
    "@bdocs/unist-utils": "workspace:*",
    "@bdocs/highlight": "workspace:*",
    "esbuild": "^0.25.0",
    "hast-util-to-html": "^9.0.5",
    "piscina": "^5.3.0",
    "satteri": "^0.9.2"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.12.0",
    "tsdown": "^0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "boltdocs": "workspace:^",
    "vite": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bolt-docs/boltdocs.git",
    "directory": "packages/boltdocs-processor-satteri"
  },
  "license": "MIT"
}
