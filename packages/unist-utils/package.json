{
  "name": "@bdocs/unist-utils",
  "version": "0.2.1",
  "description": "Strictly-typed AST utilities for unist/mdast/hast used by Boltdocs core and official plugins.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.30.2",
  "keywords": [
    "boltdocs",
    "unist",
    "mdast",
    "hast",
    "mdx",
    "ast",
    "remark",
    "rehype"
  ],
  "author": "Jesus Alcala",
  "license": "MIT",
  "dependencies": {
    "@bdocs/contracts": "workspace:*",
    "@types/unist": "^3.0.3",
    "unist": "^3.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "tsdown": "^0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
