{
  "name": "@bdocs/react-binding",
  "version": "1.1.0",
  "type": "module",
  "description": "The React UI binding for Boltdocs: Vite wiring and the client entry root. The only supported binding; the engine resolves it by name and never imports React itself.",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "boltdocs": {
    "source": {
      ".": "./src/index.ts",
      "./vite": "./src/vite.ts"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "dependencies": {
    "@bdocs/runtime": "workspace:*",
    "@bdocs/ssg": "workspace:*",
    "@vitejs/plugin-react": "6.0.1",
    "react-refresh": "^0.17.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bolt-docs/boltdocs.git",
    "directory": "packages/boltdocs-react-binding"
  },
  "license": "MIT"
}
