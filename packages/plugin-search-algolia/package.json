{
  "name": "@bdocs/plugin-search-algolia",
  "version": "1.0.0",
  "description": "Push Boltdocs search records to an Algolia index at build time",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./records": {
      "types": "./dist/node/records.d.mts",
      "import": "./dist/node/records.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@bdocs/contracts": "workspace:*"
  },
  "peerDependencies": {
    "boltdocs": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "boltdocs": "workspace:^",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "tsdown-config": "workspace:*",
    "vitest": "^3.2.4"
  }
}
