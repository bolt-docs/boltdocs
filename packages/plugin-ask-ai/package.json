{
  "name": "@bdocs/plugin-ask-ai",
  "version": "0.3.0",
  "description": "Secure, page-scoped streaming AI assistant for Boltdocs with provider presets, hardened server adapters, automatic floating UI, and customizable client components.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@bdocs/dui": "^0.6.0",
    "clsx": "2.1.1",
    "openai": "^4.77.0",
    "streamdown": "^1.0.0",
    "tailwind-merge": "3.5.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "boltdocs": ">=3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "boltdocs": "workspace:*",
    "jsdom": "^24.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
