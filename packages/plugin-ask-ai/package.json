{
  "name": "@bdocs/plugin-ask-ai",
  "version": "0.1.0",
  "description": "Context-aware AI assistant querying plugin for Boltdocs",
  "main": "dist/node/index.js",
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.30.2",
  "author": "Jesus Alcala",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@bdocs/dui": "^0.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "boltdocs": "workspace:*",
    "flexsearch": "0.8.212",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
