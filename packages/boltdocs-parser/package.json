{
  "name": "@bdocs/parser",
  "version": "1.2.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "install.mjs"
  ],
  "scripts": {
    "postinstall": "node install.mjs",
    "prepack": "node scripts/copy-wasm.mjs --require",
    "build": "tsdown index.ts && node scripts/copy-wasm.mjs",
    "build:wasm": "zig build -Dtarget=wasm32-wasi -Doptimize=ReleaseSmall",
    "build:native": "zig build -Doptimize=ReleaseSmall",
    "build:napi": "zig build-lib src/napi.zig -dynamic -fPIC --name bdocs_parser_napi -fstrip -OReleaseSmall -lc",
    "build:all-platforms": "node scripts/build-all.mjs",
    "test": "zig build test",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "pretest:ts": "pnpm build:napi"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "koffi": "^3.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bolt-docs/boltdocs.git",
    "directory": "packages/boltdocs-parser"
  }
}
