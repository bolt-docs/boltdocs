{
  "name": "boltdocs",
  "version": "3.3.6",
  "description": "A lightweight documentation generator for React projects.",
  "main": "dist/node/index.mjs",
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.d.ts",
  "bin": {
    "boltdocs": "bin/boltdocs.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.mjs"
    },
    "./node/cache": {
      "types": "./dist/node/cache.d.ts",
      "default": "./dist/node/cache.mjs"
    },
    "./node/highlight": {
      "types": "./dist/node/highlight.d.ts",
      "default": "./dist/node/highlight.mjs"
    },
    "./node/search": {
      "types": "./dist/node/search/registry.d.ts",
      "default": "./dist/node/search/registry.mjs"
    },
    "./node/mdx/shiki-adapter": {
      "types": "./dist/node/mdx/shiki-adapter.d.ts",
      "default": "./dist/node/mdx/shiki-adapter.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/router": {
      "types": "./dist/client/router.d.ts",
      "default": "./dist/client/router.js"
    },
    "./primitives": {
      "types": "./dist/client/primitives.d.ts",
      "default": "./dist/client/primitives.js"
    },
    "./mdx": {
      "types": "./dist/client/mdx.d.ts",
      "default": "./dist/client/mdx.js"
    },
    "./theme/reset.css": "./dist/client/theme/reset.css"
  },
  "files": [
    "dist",
    "bin",
    "src/shared"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "pnpm exec biome format --write",
    "lint": "pnpm exec biome lint --write",
    "check": "pnpm exec biome check --write"
  },
  "keywords": [
    "docs",
    "documentation",
    "static site generator",
    "ssg",
    "markdown",
    "mdx",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Jesus Alcala",
  "license": "MIT",
  "dependencies": {
    "@bdocs/contracts": "workspace:*",
    "@bdocs/dui": "^0.6.0",
    "@bdocs/grammars": "workspace:*",
    "@bdocs/parser": "workspace:*",
    "@bdocs/primitives": "workspace:*",
    "@bdocs/processor-satteri": "workspace:*",
    "@bdocs/runtime": "workspace:*",
    "@bdocs/ssg": "workspace:*",
    "@bdocs/theme-neutral": "workspace:*",
    "@bdocs/unist-utils": "workspace:*",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@shikijs/types": "3.23.0",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "cac": "7.0.0",
    "clsx": "2.1.1",
    "dompurify": "^3.3.3",
    "fastest-levenshtein": "^1.0.16",
    "fdir": "^6.5.0",
    "github-slugger": "2.0.0",
    "jiti": "^2.7.0",
    "lru-cache": "^11.3.6",
    "picomatch": "^4.0.4",
    "react-helmet-async": "^2.0.1",
    "react-refresh": "^0.17.0",
    "scroll-into-view-if-needed": "3.1.0",
    "semver": "^7.7.4",
    "tailwind-merge": "3.5.0",
    "vite": "8.1.5",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/semver": "7.7.1",
    "@vercel/node": "^5.8.12",
    "jsdom": "^24.1.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
