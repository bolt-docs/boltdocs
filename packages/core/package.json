{
  "name": "boltdocs",
  "version": "3.2.0",
  "description": "A lightweight documentation generator for React projects.",
  "main": "dist/node/index.mjs",
  "module": "dist/node/index.mjs",
  "types": "dist/node/index.d.ts",
  "bin": {
    "boltdocs": "bin/boltdocs.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./node/cache": {
      "types": "./dist/node/cache.d.ts",
      "import": "./dist/node/cache.mjs",
      "require": "./dist/node/cache.cjs"
    },
    "./node/mdx/shiki-adapter": {
      "types": "./dist/node/mdx/shiki-adapter.d.ts",
      "import": "./dist/node/mdx/shiki-adapter.mjs",
      "require": "./dist/node/mdx/shiki-adapter.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./primitives": {
      "types": "./dist/client/primitives.d.ts",
      "import": "./dist/client/primitives.js",
      "require": "./dist/client/primitives.cjs"
    },
    "./mdx": {
      "types": "./dist/client/mdx.d.ts",
      "import": "./dist/client/mdx.js",
      "require": "./dist/client/mdx.cjs"
    },
    "./theme/neutral.css": "./dist/client/theme/neutral.css",
    "./theme/reset.css": "./dist/client/theme/reset.css"
  },
  "files": [
    "dist",
    "bin",
    "src/shared"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "pnpm exec biome format --write",
    "lint": "pnpm exec biome lint --write",
    "check": "pnpm exec biome check --write"
  },
  "keywords": [
    "docs",
    "documentation",
    "static site generator",
    "ssg",
    "markdown",
    "mdx",
    "react",
    "vite",
    "typescript"
  ],
  "author": "Jesus Alcala",
  "license": "MIT",
  "dependencies": {
    "@bdocs/dui": "^0.3.0",
    "@bdocs/parser": "workspace:*",
    "@bdocs/plugin-image-optimizer": "workspace:*",
    "@bdocs/ssg": "workspace:*",
    "@bdocs/unist-utils": "workspace:*",
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "cac": "7.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastest-levenshtein": "^1.0.16",
    "invariant": "^2.2.4",
    "fdir": "^6.5.0",
    "flexsearch": "0.8.212",
    "github-slugger": "2.0.0",
    "isomorphic-dompurify": "3.7.1",
    "lru-cache": "^11.3.6",
    "picomatch": "^4.0.4",
    "semver": "^7.7.4",
    "react-helmet-async": "^2.0.1",
    "react-router-dom": "^7.0.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "scroll-into-view-if-needed": "3.1.0",
    "shiki": "3.23.0",
    "tailwind-merge": "3.5.0",
    "unist-util-visit": "5.1.0",
    "vite": "7.0.0 || 8.0.0",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-aria-components": "^1.16.0"
  },
  "packageManager": "pnpm@10.30.2",
  "devDependencies": {
    "@bdocs/processor-satteri": "workspace:*",
    "@netlify/functions": "^5.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/semver": "7.7.1",
    "@vercel/node": "^5.8.12",
    "jsdom": "^24.1.0",
    "react-aria-components": "1.16.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "0.21.7",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
