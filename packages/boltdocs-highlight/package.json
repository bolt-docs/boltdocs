{
  "name": "@bdocs/highlight",
  "version": "1.1.0",
  "description": "Prism-based syntax highlighter for Boltdocs (engine-agnostic adapter)",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bdocs/contracts": "workspace:*",
    "@bdocs/unist-utils": "workspace:*",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@types/prismjs": "^1.26.6",
    "tsdown": "^0.21.7",
    "tsdown-config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.2"
}
